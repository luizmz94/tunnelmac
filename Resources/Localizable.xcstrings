      }
    },
    "A identidade foi importada, mas não foi possível preservar um certificado intermediário": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Identität wurde importiert, aber ein Zwischenzertifikat konnte nicht übernommen werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The identity was imported, but an intermediate certificate could not be kept"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad se importó, pero no se pudo conservar un certificado intermedio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identité a été importée, mais un certificat intermédiaire n’a pas pu être conservé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहचान आयात हो गई, लेकिन एक मध्यवर्ती प्रमाणपत्र सुरक्षित नहीं रखा जा सका"
          }
        }
      }
    },
    "A instalação mudou desde a inspeção. Revise o inventário novamente antes de aprovar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation hat sich seit der Prüfung geändert. Prüfe das Inventar erneut, bevor du genehmigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installation changed since it was inspected. Review the inventory again before approving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación cambió desde la inspección. Revisa el inventario de nuevo antes de aprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installation a changé depuis l’inspection. Revérifiez l’inventaire avant d’approuver."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँच के बाद इंस्टॉलेशन बदल गया है। अनुमोदन से पहले सूची फिर से देखें।"
          }
        }
      }
    },
    "A limpeza global não foi confirmada; o serviço não foi removido. Se o helper for antigo, remova o serviço pelo app anterior antes de atualizar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die globale Bereinigung wurde nicht bestätigt; der Dienst wurde nicht entfernt. Ist der Helper alt, entferne den Dienst vor dem Update über die vorherige App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global cleanup was not confirmed; the service was not removed. If the helper is old, remove the service from the previous app before updating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se confirmó la limpieza global; el servicio no se eliminó. Si el helper es antiguo, elimina el servicio desde la app anterior antes de actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage global n’a pas été confirmé ; le service n’a pas été supprimé. Si le helper est ancien, supprimez le service depuis l’app précédente avant la mise à jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैश्विक सफ़ाई की पुष्टि नहीं हुई; सेवा नहीं हटाई गई। यदि helper पुराना है, तो अपडेट से पहले पिछले ऐप से सेवा हटाएँ।"
          }
        }
      }
    },
    "A pasta contém mais de um perfil (%@). Escolha o arquivo desejado.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner enthält mehr als ein Profil (%@). Wähle die gewünschte Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder contains more than one profile (%@). Choose the file you want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta contiene más de un perfil (%@). Elige el archivo que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier contient plusieurs profils (%@). Choisissez le fichier voulu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर में एक से अधिक प्रोफ़ाइल हैं (%@)। अपनी पसंद की फ़ाइल चुनें।"
          }
        }
      }
    },
    "A pasta não contém um perfil .ovpn ou config.conf.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner enthält kein .ovpn- oder config.conf-Profil."
          }
