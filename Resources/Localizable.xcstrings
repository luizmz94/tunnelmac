            "state": "translated",
            "value": "La carpeta no contiene un perfil .ovpn ni config.conf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier ne contient pas de profil .ovpn ou config.conf."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर में कोई .ovpn या config.conf प्रोफ़ाइल नहीं है।"
          }
        }
      }
    },
    "A porta deve estar entre 1 e 65535.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Port muss zwischen 1 und 65535 liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The port must be between 1 and 65535."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto debe estar entre 1 y 65535."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port doit être compris entre 1 et 65535."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोर्ट 1 और 65535 के बीच होना चाहिए।"
          }
        }
      }
    },
    "A rede apresenta certificados próprios": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Netzwerk präsentiert eigene Zertifikate"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network presents its own certificates"
