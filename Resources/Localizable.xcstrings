    "[#] DNS da VPN (%@) para %@; os demais nomes seguem no DNS atual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[#] VPN-DNS (%@) für %@; andere Namen nutzen weiter das aktuelle DNS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[#] VPN DNS (%@) for %@; other names keep using the current DNS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[#] DNS de la VPN (%@) para %@; los demás nombres siguen en el DNS actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[#] DNS du VPN (%@) pour %@ ; les autres noms restent sur le DNS actuel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[#] %2$@ के लिए VPN DNS (%1$@); अन्य नाम मौजूदा DNS का उपयोग करते रहेंगे।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "[#] DNS da VPN (%1$@) para %2$@; os demais nomes seguem no DNS atual."
          }
        }
      }
    },
    "[#] DNS da VPN (%@) para todos os nomes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[#] VPN-DNS (%@) für alle Namen."
          }
        },
        "en": {
          "stringUnit": {
