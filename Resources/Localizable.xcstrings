          }
        }
      }
    },
    "Há conexões ativas, em andamento ou com reconexão agendada. O app aguardará o encerramento e a limpeza das VPNs antes de sair.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt aktive, laufende oder zur Wiederverbindung geplante Verbindungen. Die App wartet vor dem Beenden, bis die VPNs beendet und bereinigt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are connections that are active, in progress or with a reconnection scheduled. The app will wait for the VPNs to shut down and clean up before quitting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay conexiones activas, en curso o con reconexión programada. La app esperará al cierre y la limpieza de las VPN antes de salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des connexions sont actives, en cours ou ont une reconnexion programmée. L’app attendra l’arrêt et le nettoyage des VPN avant de quitter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ कनेक्शन सक्रिय, प्रगति पर या पुनः कनेक्शन के लिए निर्धारित हैं। बंद होने से पहले ऐप VPN के बंद होने और सफ़ाई की प्रतीक्षा करेगा।"
          }
        }
      }
    },
    "Há sessões ativas ou encerrando; desconecte antes de remover os arquivos do serviço.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt aktive oder endende Sitzungen; trenne sie, bevor du die Dateien des Dienstes entfernst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are active or ending sessions; disconnect before removing the service’s files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay sesiones activas o cerrándose; desconecta antes de eliminar los archivos del servicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des sessions sont actives ou en cours de fermeture ; déconnectez avant de supprimer les fichiers du service."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ सत्र सक्रिय हैं या समाप्त हो रहे हैं; सेवा की फ़ाइलें हटाने से पहले डिस्कनेक्ट करें।"
          }
        }
      }
    },
    "Há sessões ou supervisores pendentes; manutenção cancelada.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt ausstehende Sitzungen oder Supervisoren; Wartung abgebrochen."
