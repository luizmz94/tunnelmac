    "Chave pública deste perfil, a que o administrador do servidor cadastra. A chave privada nunca é mostrada.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der öffentliche Schlüssel dieses Profils, den der Server-Administrator einträgt. Der private Schlüssel wird nie angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile’s public key, the one the server administrator registers. The private key is never shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave pública de este perfil, la que registra el administrador del servidor. La clave privada nunca se muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé publique de ce profil, celle que l’administrateur du serveur enregistre. La clé privée n’est jamais affichée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोफ़ाइल की सार्वजनिक कुंजी, जिसे सर्वर व्यवस्थापक दर्ज करता है। निजी कुंजी कभी नहीं दिखाई जाती।"
          }
        }
      }
    },
