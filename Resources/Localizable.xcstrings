    "Ligue o TunnelMac em Ajustes do Sistema › Itens de Início › Permitir em segundo plano.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere TunnelMac unter Systemeinstellungen › Anmeldeobjekte › Im Hintergrund erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on TunnelMac in System Settings › Login Items › Allow in the Background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa TunnelMac en Ajustes del Sistema › Ítems de inicio › Permitir en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez TunnelMac dans Réglages Système › Ouverture › Autoriser en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्स › लॉगिन आइटम › बैकग्राउंड में अनुमति दें में TunnelMac चालू करें।"
          }
        }
      }
    },
    "Ligue o TunnelMac em Permitir em segundo plano": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere TunnelMac unter „Im Hintergrund erlauben“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on TunnelMac in Allow in the Background"
