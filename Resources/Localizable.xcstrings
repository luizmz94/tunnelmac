        }
      }
    },
    "O app está em %@. Para uso real, instale-o em /Applications antes de ativar o serviço (o registro aponta para este bundle).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App liegt in %@. Installiere sie für den echten Einsatz in /Applications, bevor du den Dienst aktivierst (die Registrierung verweist auf dieses Bundle)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is in %@. For real use, install it in /Applications before turning on the service (the registration points to this bundle)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app está en %@. Para uso real, instálala en /Applications antes de activar el servicio (el registro apunta a este bundle)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app se trouve dans %@. Pour un usage réel, installez-la dans /Applications avant d’activer le service (l’enregistrement pointe vers ce bundle)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप %@ में है। वास्तविक उपयोग के लिए सेवा चालू करने से पहले इसे /Applications में इंस्टॉल करें (पंजीकरण इसी bundle की ओर इंगित करता है)।"
          }
        }
      }
    },
    "O app já guardou o perfil e as chaves. Os originais não são mais necessários:\n\n": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App hat das Profil und die Schlüssel bereits gespeichert. Die Originale werden nicht mehr benötigt:\n\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has already saved the profile and the keys. The originals are no longer needed:\n\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app ya guardó el perfil y las claves. Los originales ya no son necesarios:\n\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app a déjà enregistré le profil et les clés. Les originaux ne sont plus nécessaires :\n\n"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप ने प्रोफ़ाइल और कुंजियाँ पहले ही सहेज ली हैं। मूल फ़ाइलों की अब आवश्यकता नहीं है:\n\n"
          }
        }
      }
    },
    "O app já guardou o perfil. O original não é mais necessário e ainda contém a chave privada:\n\n": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App hat das Profil bereits gespeichert. Das Original wird nicht mehr benötigt und enthält noch den privaten Schlüssel:\n\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app has already saved the profile. The original is no longer needed and still contains the private key:\n\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app ya guardó el perfil. El original ya no es necesario y aún contiene la clave privada:\n\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app a déjà enregistré le profil. L’original n’est plus nécessaire et contient encore la clé privée :\n\n"
