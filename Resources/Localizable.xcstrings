        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre tunnel WireGuard contrôle le DNS ; déconnectez-le avant d’utiliser le DNS de ce profil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरा WireGuard टनल DNS नियंत्रित करता है; इस प्रोफ़ाइल का DNS उपयोग करने से पहले उसे डिस्कनेक्ट करें।"
          }
        }
      }
    },
