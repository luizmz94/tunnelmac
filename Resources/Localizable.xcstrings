    "ERROR: A sessão de autenticação não foi fornecida.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ERROR: Die Authentifizierungssitzung wurde nicht übergeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ERROR: The authentication session was not provided."
