          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रबंधित कॉपी ने %@ नहीं दिखाया (कोड %d)।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "A cópia gerenciada não apresentou %1$@ (código %2$d)."
          }
