            "state": "translated",
            "value": "<connection> ब्लॉक अभी समर्थित नहीं हैं। प्रोफ़ाइल में ही remote निर्देशों का उपयोग करें।"
          }
        }
      }
    },
    "Build sem Team ID (assinatura ad hoc). O serviço privilegiado exige assinatura Apple Development ou Developer ID; operações root ficam desabilitadas.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build ohne Team-ID (Ad-hoc-Signatur). Der privilegierte Dienst erfordert eine Apple-Development- oder Developer-ID-Signatur; Root-Vorgänge sind deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build without a Team ID (ad hoc signature). The privileged service requires an Apple Development or Developer ID signature; root operations are disabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Build sin Team ID (firma ad hoc). El servicio con privilegios requiere firma Apple Development o Developer ID; las operaciones root quedan desactivadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Build sans Team ID (signature ad hoc). Le service privilégié exige une signature Apple Development ou Developer ID ; les opérations root sont désactivées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Team ID के बिना बिल्ड (ad hoc हस्ताक्षर)। विशेषाधिकार प्राप्त सेवा को Apple Development या Developer ID हस्ताक्षर चाहिए; root कार्य अक्षम हैं।"
          }
        }
      }
    },
