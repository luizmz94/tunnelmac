    "%@ usa uma política criptográfica antiga. Confirme a necessidade com o administrador; o app preservou o parâmetro.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet eine veraltete Kryptorichtlinie. Kläre mit dem Administrator, ob sie nötig ist; die App hat den Parameter beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses an old cryptographic policy. Confirm with the administrator that it is needed; the app kept the setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa una política criptográfica antigua. Confirma con el administrador si es necesaria; la app conservó el parámetro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ utilise une règle cryptographique ancienne. Confirmez sa nécessité avec l’administrateur ; l’app a conservé le paramètre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पुरानी क्रिप्टोग्राफ़िक नीति का उपयोग करता है। व्यवस्थापक से इसकी आवश्यकता की पुष्टि करें; ऐप ने यह पैरामीटर बनाए रखा है।"
          }
        }
