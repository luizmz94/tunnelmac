          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil n’a aucun [Peer]."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल में कोई [Peer] नहीं है।"
          }
        }
      }
    },
    "O perfil não tem nenhum servidor (remote).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil hat keinen Server (remote)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile has no server (remote)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil no tiene ningún servidor (remote)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil n’a aucun serveur (remote)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल में कोई सर्वर (remote) नहीं है।"
          }
        }
      }
    },
    "O perfil não verifica a identidade do servidor (remote-cert-tls server ou verify-x509-name). Solicite um perfil atualizado ao administrador.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil prüft die Identität des Servers nicht (remote-cert-tls server oder verify-x509-name). Fordere beim Administrator ein aktualisiertes Profil an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile does not verify the server’s identity (remote-cert-tls server or verify-x509-name). Ask the administrator for an updated profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil no verifica la identidad del servidor (remote-cert-tls server o verify-x509-name). Solicita un perfil actualizado al administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil ne vérifie pas l’identité du serveur (remote-cert-tls server ou verify-x509-name). Demandez un profil à jour à l’administrateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल सर्वर की पहचान सत्यापित नहीं करती (remote-cert-tls server या verify-x509-name)। व्यवस्थापक से अपडेट की गई प्रोफ़ाइल माँगें।"
          }
        }
      }
    },
    "O perfil não é de cliente (falta client).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil ist kein Client-Profil (client fehlt)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile is not a client profile (client is missing)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil no es de cliente (falta client)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil n’est pas un profil client (client manquant)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल क्लाइंट प्रोफ़ाइल नहीं है (client अनुपस्थित)।"
          }
        }
      }
    },
    "O perfil precisa ser um arquivo de texto de até 256 KB.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil muss eine Textdatei bis 256 KB sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile must be a text file of up to 256 KB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil debe ser un archivo de texto de hasta 256 KB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil doit être un fichier texte de 256 Ko maximum."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल अधिकतम 256 KB की टेक्स्ट फ़ाइल होनी चाहिए।"
          }
        }
      }
    },
    "O perfil usa auth %@, que o OpenVPN não aceita. O app pode corrigir a cópia do perfil para auth %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil verwendet auth %@, das OpenVPN nicht akzeptiert. Die App kann die Kopie des Profils auf auth %@ korrigieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile uses auth %@, which OpenVPN does not accept. The app can fix the profile’s copy to auth %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil usa auth %@, que OpenVPN no acepta. La app puede corregir la copia del perfil a auth %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil utilise auth %@, qu’OpenVPN n’accepte pas. L’app peut corriger la copie du profil en auth %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल auth %@ का उपयोग करती है, जिसे OpenVPN स्वीकार नहीं करता। ऐप प्रोफ़ाइल की कॉपी को auth %@ में ठीक कर सकता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "O perfil usa auth %1$@, que o OpenVPN não aceita. O app pode corrigir a cópia do perfil para auth %2$@."
          }
        }
      }
    },
    "O perfil usa diretivas que o app ainda não suporta: %@. Nada foi importado.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil verwendet Direktiven, die die App noch nicht unterstützt: %@. Nichts wurde importiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile uses directives the app does not support yet: %@. Nothing was imported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil usa directivas que la app aún no admite: %@. No se importó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil utilise des directives que l’app ne prend pas encore en charge : %@. Rien n’a été importé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल ऐसे निर्देशों का उपयोग करती है जिन्हें ऐप अभी समर्थन नहीं करता: %@। कुछ भी आयात नहीं हुआ।"
          }
        }
      }
    },
    "O runtime OpenVPN não possui dns-updown protegido; reinstale o cliente e aprove novamente para garantir o DNS da VPN.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der OpenVPN-Laufzeitumgebung fehlt ein geschütztes dns-updown; installiere den Client neu und genehmige ihn erneut, damit das VPN-DNS funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The OpenVPN runtime has no protected dns-updown; reinstall the client and approve it again to ensure the VPN’s DNS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El runtime de OpenVPN no tiene dns-updown protegido; reinstala el cliente y vuelve a aprobarlo para garantizar el DNS de la VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le runtime OpenVPN n’a pas de dns-updown protégé ; réinstallez le client et approuvez-le de nouveau pour garantir le DNS du VPN."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN runtime में सुरक्षित dns-updown नहीं है; VPN का DNS सुनिश्चित करने के लिए क्लाइंट फिर से इंस्टॉल करें और फिर से अनुमोदित करें।"
          }
        }
      }
    },
    "O runtime aprovado foi alterado (%@); aprove novamente.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die genehmigte Laufzeitumgebung wurde geändert (%@); genehmige sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approved runtime was changed (%@); approve it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El runtime aprobado se modificó (%@); vuelve a aprobarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le runtime approuvé a été modifié (%@) ; approuvez-le de nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमोदित runtime बदल गया है (%@); इसे फिर से अनुमोदित करें।"
          }
        }
      }
    },
    "O script dns-updown não usa um interpretador do sistema (/bin/bash ou /bin/sh).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das dns-updown-Skript verwendet keinen Systeminterpreter (/bin/bash oder /bin/sh)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dns-updown script does not use a system interpreter (/bin/bash or /bin/sh)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El script dns-updown no usa un intérprete del sistema (/bin/bash o /bin/sh)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le script dns-updown n’utilise pas un interpréteur système (/bin/bash ou /bin/sh)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "dns-updown स्क्रिप्ट सिस्टम इंटरप्रेटर (/bin/bash या /bin/sh) का उपयोग नहीं करती।"
          }
        }
      }
    },
    "O servidor não respondeu como um gateway GlobalProtect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nicht wie ein GlobalProtect-Gateway geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not answer like a GlobalProtect gateway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no respondió como un gateway GlobalProtect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas répondu comme une passerelle GlobalProtect."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने GlobalProtect गेटवे की तरह उत्तर नहीं दिया।"
          }
        }
      }
    },
    "O servidor recusou usuário ou senha. Confira as credenciais antes de tentar de novo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat Benutzername oder Passwort abgelehnt. Prüfe die Anmeldedaten, bevor du es erneut versuchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the user name or password. Check the credentials before trying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó el usuario o la contraseña. Revisa las credenciales antes de volver a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé l’utilisateur ou le mot de passe. Vérifiez les identifiants avant de réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने उपयोगकर्ता नाम या पासवर्ड अस्वीकार किया। फिर से प्रयास करने से पहले क्रेडेंशियल जाँचें।"
          }
        }
      }
    },
    "O serviço ajustou o plano de execução ao openfortivpn aprovado.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst hat den Ausführungsplan an das genehmigte openfortivpn angepasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service adjusted the run plan to the approved openfortivpn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio ajustó el plan de ejecución al openfortivpn aprobado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service a ajusté le plan d’exécution à l’openfortivpn approuvé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेवा ने निष्पादन योजना को अनुमोदित openfortivpn के अनुसार समायोजित किया।"
          }
        }
      }
    },
    "O serviço está habilitado, mas o handshake autenticado falhou: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst ist aktiviert, aber der authentifizierte Handshake ist fehlgeschlagen: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service is turned on, but the authenticated handshake failed: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio está habilitado, pero el handshake autenticado falló: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service est activé, mais le handshake authentifié a échoué : %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेवा चालू है, लेकिन प्रमाणित handshake विफल रहा: %@"
          }
        }
      }
    },
    "O serviço está sendo removido ou atualizado; novas conexões aguardam.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst wird entfernt oder aktualisiert; neue Verbindungen warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service is being removed or updated; new connections are waiting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio se está eliminando o actualizando; las nuevas conexiones esperan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service est en cours de suppression ou de mise à jour ; les nouvelles connexions attendent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेवा हटाई या अपडेट की जा रही है; नए कनेक्शन प्रतीक्षा में हैं।"
          }
        }
      }
    },
    "O serviço não guarda senhas. Você pode removê-lo a qualquer momento em Ajustes.": {
      "localizations": {
        "de": {
          "stringUnit": {
