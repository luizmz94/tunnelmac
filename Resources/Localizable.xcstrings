    "Script de rede inválido.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiges Netzwerkskript."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid network script."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Script de red no válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Script réseau non valide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमान्य नेटवर्क स्क्रिप्ट।"
          }
        }
      }
    },
    "Script dns-updown do OpenVPN não encontrado junto ao executável: o túnel funcionará, mas o DNS da VPN não será configurado.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das dns-updown-Skript von OpenVPN wurde nicht neben der ausführbaren Datei gefunden: Der Tunnel funktioniert, aber das VPN-DNS wird nicht gesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN’s dns-updown script was not found next to the executable: the tunnel will work, but the VPN’s DNS will not be set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el script dns-updown de OpenVPN junto al ejecutable: el túnel funcionará, pero el DNS de la VPN no se configurará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le script dns-updown d’OpenVPN est introuvable à côté de l’exécutable : le tunnel fonctionnera, mais le DNS du VPN ne sera pas configuré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN की dns-updown स्क्रिप्ट एक्ज़ीक्यूटेबल के पास नहीं मिली: टनल काम करेगा, लेकिन VPN का DNS सेट नहीं होगा।"
          }
        }
      }
    },
    "Se sites mostrarem que a conexão não é privada, a rede pode inspecionar HTTPS com uma autoridade própria.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Websites melden, dass die Verbindung nicht privat ist, prüft das Netzwerk HTTPS möglicherweise mit einer eigenen Zertifizierungsstelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If sites say the connection is not private, the network may inspect HTTPS with its own authority."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los sitios indican que la conexión no es privada, la red puede inspeccionar HTTPS con una autoridad propia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si des sites indiquent que la connexion n’est pas privée, le réseau inspecte peut-être HTTPS avec sa propre autorité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर साइटें बताएँ कि कनेक्शन निजी नहीं है, तो नेटवर्क अपने प्राधिकरण से HTTPS की जाँच कर सकता है।"
          }
        }
      }
    },
    "Segue o gateway, que costuma mandar toda a internet pela VPN, onde a empresa pode inspecionar HTTPS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgt dem Gateway, das meist den gesamten Internetverkehr über das VPN leitet, wo das Unternehmen HTTPS prüfen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows the gateway, which usually sends all internet traffic through the VPN, where the company may inspect HTTPS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue al gateway, que suele enviar todo el tráfico de internet por la VPN, donde la empresa puede inspeccionar HTTPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suit la passerelle, qui envoie généralement tout le trafic internet par le VPN, où l’entreprise peut inspecter HTTPS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेटवे का पालन करता है, जो आमतौर पर सारा इंटरनेट ट्रैफ़िक VPN से भेजता है, जहाँ कंपनी HTTPS की जाँच कर सकती है।"
          }
        }
      }
    },
