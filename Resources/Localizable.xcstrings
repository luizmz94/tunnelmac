    "Aguardando a autenticação SAML anterior liberar o callback local 8020. Túneis já conectados continuam ativos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte, bis die vorherige SAML-Anmeldung den lokalen Callback 8020 freigibt. Bereits verbundene Tunnel bleiben aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the previous SAML sign-in to release local callback 8020. Tunnels already connected stay active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que la autenticación SAML anterior libere el callback local 8020. Los túneles ya conectados siguen activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente que l’authentification SAML précédente libère le callback local 8020. Les tunnels déjà connectés restent actifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले SAML साइन-इन द्वारा लोकल callback 8020 छोड़े जाने की प्रतीक्षा है। पहले से जुड़े टनल सक्रिय रहेंगे।"
          }
        }
      }
    },
