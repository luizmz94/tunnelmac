    "Blocos <connection> ainda não são suportados. Use diretivas remote no próprio perfil.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "<connection>-Blöcke werden noch nicht unterstützt. Verwende remote-Direktiven im Profil selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<connection> blocks are not supported yet. Use remote directives in the profile itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los bloques <connection> aún no son compatibles. Usa directivas remote en el propio perfil."
          }
        },
        "fr": {
