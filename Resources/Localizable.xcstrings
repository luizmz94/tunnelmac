          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ERROR: le délai d’attente de la réponse SAML du navigateur a expiré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ERROR: ब्राउज़र से SAML उत्तर की प्रतीक्षा का समय समाप्त हो गया।"
          }
        }
