    "O OpenVPN 2.7 não aceita %@; %@ é o equivalente e precisa ser igual ao do servidor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 2.7 akzeptiert %@ nicht; %@ ist das Gegenstück und muss mit dem Server übereinstimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 2.7 does not accept %@; %@ is the equivalent and must match the server’s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 2.7 no acepta %@; %@ es el equivalente y debe coincidir con el del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 2.7 n’accepte pas %@ ; %@ est l’équivalent et doit correspondre à celui du serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 2.7 %@ स्वीकार नहीं करता; %@ इसका समकक्ष है और सर्वर से मेल खाना चाहिए।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "O OpenVPN 2.7 não aceita %1$@; %2$@ é o equivalente e precisa ser igual ao do servidor."
          }
        }
      }
    },
    "O OpenVPN 2.7 recusa auth %@; %@ é o equivalente e precisa ser igual ao do servidor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 2.7 lehnt auth %@ ab; %@ ist das Gegenstück und muss mit dem Server übereinstimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 2.7 rejects auth %@; %@ is the equivalent and must match the server’s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 2.7 rechaza auth %@; %@ es el equivalente y debe coincidir con el del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 2.7 refuse auth %@ ; %@ est l’équivalent et doit correspondre à celui du serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenVPN 2.7 auth %@ अस्वीकार करता है; %@ इसका समकक्ष है और सर्वर से मेल खाना चाहिए।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "O OpenVPN 2.7 recusa auth %1$@; %2$@ é o equivalente e precisa ser igual ao do servidor."
          }
        }
      }
    },
