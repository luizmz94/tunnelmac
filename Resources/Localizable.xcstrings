    "Esta conexão já tem uma sessão ativa ou encerrando.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung hat bereits eine aktive oder endende Sitzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection already has an active or ending session."
          }
        },
