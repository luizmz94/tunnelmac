    "Confira o usuário e a senha antes de tentar de novo, para evitar o bloqueio da conta.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe Benutzername und Passwort, bevor du es erneut versuchst, damit das Konto nicht gesperrt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the user name and password before trying again, to avoid locking the account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el usuario y la contraseña antes de volver a intentarlo, para evitar el bloqueo de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’utilisateur et le mot de passe avant de réessayer, pour éviter le blocage du compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाता लॉक होने से बचाने के लिए फिर से प्रयास करने से पहले उपयोगकर्ता नाम और पासवर्ड जाँचें।"
          }
        }
      }
    },
