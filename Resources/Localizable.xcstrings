            "value": "Lade die neue Version auf GitHub und ersetze die App, während sie geschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the new version on GitHub and replace the app while it is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga la nueva versión en GitHub y reemplaza la app con ella cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez la nouvelle version sur GitHub et remplacez l’app pendant qu’elle est fermée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub से नया संस्करण डाउनलोड करें और ऐप बंद होने पर उसे बदलें।"
          }
        }
      }
    },
    "Bloco <%@> com conteúdo inesperado (somente PEM ou chave estática em texto).": {
