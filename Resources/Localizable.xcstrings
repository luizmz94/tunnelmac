          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibilité"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संगतता"
          }
        }
      }
    },
    "Compressão do túnel pode expor informações do tráfego. Solicite um perfil sem compressão; o parâmetro foi preservado para compatibilidade.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimierung im Tunnel kann Informationen über den Datenverkehr preisgeben. Fordere ein Profil ohne Komprimierung an; der Parameter wurde aus Kompatibilitätsgründen beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnel compression can expose information about the traffic. Ask for a profile without compression; the setting was kept for compatibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compresión del túnel puede exponer información del tráfico. Solicita un perfil sin compresión; el parámetro se conservó por compatibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compression du tunnel peut exposer des informations sur le trafic. Demandez un profil sans compression ; le paramètre a été conservé par compatibilité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टनल संपीड़न ट्रैफ़िक की जानकारी उजागर कर सकता है। बिना संपीड़न वाली प्रोफ़ाइल माँगें; संगतता के लिए पैरामीटर बनाए रखा गया है।"
          }
        }
      }
    },
