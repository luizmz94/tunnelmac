    "Baixa a versão %@ e reabre o app. As VPNs são desconectadas; conexões e senhas ficam.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt Version %@ und öffnet die App erneut. VPNs werden getrennt; Verbindungen und Passwörter bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads version %@ and reopens the app. VPNs are disconnected; connections and passwords stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga la versión %@ y vuelve a abrir la app. Las VPN se desconectan; las conexiones y contraseñas se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge la version %@ et rouvre l’app. Les VPN sont déconnectés ; connexions et mots de passe sont conservés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण %@ डाउनलोड करता है और ऐप फिर से खोलता है। VPN डिस्कनेक्ट हो जाते हैं; कनेक्शन और पासवर्ड बने रहते हैं।"
          }
        }
      }
    },
