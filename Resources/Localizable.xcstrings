    "[!] Falha ao atualizar o registro de recuperação: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Wiederherstellungsdatensatz konnte nicht aktualisiert werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Could not update the recovery record: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Error al actualizar el registro de recuperación: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Échec de la mise à jour de l’enregistrement de récupération : %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] पुनर्प्राप्ति रिकॉर्ड अपडेट करना विफल: %@"
          }
        }
      }
    },
    "[!] Nenhum handshake com o servidor após %lld s. Confira o endpoint e se o servidor conhece a chave pública deste perfil.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Kein Handshake mit dem Server nach %lld s. Prüfe den Endpunkt und ob der Server den öffentlichen Schlüssel dieses Profils kennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] No handshake with the server after %lld s. Check the endpoint and whether the server knows this profile’s public key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Ningún handshake con el servidor tras %lld s. Revisa el endpoint y si el servidor conoce la clave pública de este perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Aucun handshake avec le serveur après %lld s. Vérifiez le endpoint et que le serveur connaît la clé publique de ce profil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] %lld s बाद भी सर्वर से कोई handshake नहीं। एंडपॉइंट जाँचें और देखें कि सर्वर इस प्रोफ़ाइल की सार्वजनिक कुंजी जानता है या नहीं।"
          }
        }
      }
    },
    "[!] Não foi possível definir o DNS da internet; a VPN segue com o DNS atual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Internet-DNS konnte nicht gesetzt werden; das VPN behält das aktuelle DNS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Could not set the internet DNS; the VPN keeps the current DNS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] No se pudo definir el DNS de internet; la VPN sigue con el DNS actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Impossible de définir le DNS Internet ; le VPN conserve le DNS actuel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] इंटरनेट DNS सेट नहीं किया जा सका; VPN मौजूदा DNS के साथ जारी है।"
          }
        }
      }
    },
    "[!] Não foi possível registrar o DNS da VPN no sistema; nomes internos podem não resolver nos apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] VPN-DNS konnte nicht im System registriert werden; interne Namen werden in Apps eventuell nicht aufgelöst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Could not register the VPN’s DNS with the system; internal names may not resolve in apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] No se pudo registrar el DNS de la VPN en el sistema; puede que los nombres internos no se resuelvan en las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Impossible d’enregistrer le DNS du VPN dans le système ; les noms internes pourraient ne pas être résolus dans les apps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] VPN का DNS सिस्टम में पंजीकृत नहीं हो सका; ऐप्स में आंतरिक नाम हल नहीं हो सकते।"
          }
        }
      }
    },
    "[!] Não foi possível restaurar o DNS de antes da VPN; o serviço tenta novamente.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Das DNS von vor dem VPN konnte nicht wiederhergestellt werden; der Dienst versucht es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Could not restore the DNS from before the VPN; the service will try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] No se pudo restaurar el DNS de antes de la VPN; el servicio lo intentará de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Impossible de restaurer le DNS d’avant le VPN ; le service réessaiera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] VPN से पहले का DNS पुनर्स्थापित नहीं हो सका; सेवा फिर से प्रयास करेगी।"
          }
        }
      }
    },
    "[!] O gateway não informou domínios de DNS; nomes internos podem não resolver nos apps (só pelo IP).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Das Gateway hat keine DNS-Domains gemeldet; interne Namen werden in Apps eventuell nicht aufgelöst (nur per IP)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] The gateway did not report DNS domains; internal names may not resolve in apps (only by IP)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] El gateway no informó dominios DNS; puede que los nombres internos no se resuelvan en las apps (solo por IP)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] La passerelle n’a pas indiqué de domaines DNS ; les noms internes pourraient ne pas être résolus dans les apps (seulement par IP)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] गेटवे ने DNS डोमेन नहीं बताए; ऐप्स में आंतरिक नाम हल नहीं हो सकते (केवल IP से)।"
          }
        }
      }
    },
    "[!] Resolução do endpoint após mudança de rede pendente.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Auflösung des Endpunkts nach dem Netzwerkwechsel ausstehend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Endpoint resolution after the network change is pending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Resolución del endpoint tras el cambio de red pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Résolution du endpoint après le changement de réseau en attente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] नेटवर्क बदलने के बाद एंडपॉइंट का समाधान लंबित है।"
          }
        }
      }
    },
    "[!] Restauração do DNS pendente; registro preservado para recuperação.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] DNS-Wiederherstellung ausstehend; Datensatz für die Wiederherstellung beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] DNS restore pending; record kept for recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Restauración del DNS pendiente; registro conservado para la recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Restauration du DNS en attente ; enregistrement conservé pour la récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] DNS पुनर्स्थापना लंबित; पुनर्प्राप्ति के लिए रिकॉर्ड रखा गया।"
          }
        }
      }
    },
    "[!] Um perfil WireGuard com DNS próprio controla o DNS do sistema; o DNS da internet do TunnelMac fica para depois.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Ein WireGuard-Profil mit eigenem DNS steuert das System-DNS; das Internet-DNS von TunnelMac wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] A WireGuard profile with its own DNS controls the system DNS; TunnelMac’s internet DNS waits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Un perfil WireGuard con DNS propio controla el DNS del sistema; el DNS de internet de TunnelMac queda para después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] Un profil WireGuard avec son propre DNS contrôle le DNS du système ; le DNS Internet de TunnelMac attend."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "[!] अपने DNS वाली एक WireGuard प्रोफ़ाइल सिस्टम DNS नियंत्रित करती है; TunnelMac का इंटरनेट DNS बाद में लागू होगा।"
          }
        }
      }
    },
    "[#] DNS %@ no serviço de rede principal": {
      "localizations": {
