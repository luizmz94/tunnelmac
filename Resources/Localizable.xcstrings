          }
        }
      }
    },
    "%@: caracteres de controle ou espaços nas extremidades não são suportados.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Steuerzeichen oder Leerzeichen am Anfang/Ende werden nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: control characters or leading/trailing spaces are not supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: no se admiten caracteres de control ni espacios en los extremos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : les caractères de contrôle et les espaces en début ou fin ne sont pas pris en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: नियंत्रण वर्ण या शुरुआत/अंत में स्पेस समर्थित नहीं हैं।"
          }
        }
      }
    },
    "%@: número de argumentos inesperado.": {
      "localizations": {
        "de": {
