        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WireGuard profile has too many entries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil WireGuard tiene demasiadas entradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil WireGuard contient trop d’entrées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WireGuard प्रोफ़ाइल में बहुत अधिक प्रविष्टियाँ हैं।"
          }
        }
      }
    },
    "O perfil WireGuard tem peers demais.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das WireGuard-Profil hat zu viele Peers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WireGuard profile has too many peers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil WireGuard tiene demasiados peers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil WireGuard contient trop de peers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WireGuard प्रोफ़ाइल में बहुत अधिक peers हैं।"
          }
        }
      }
    },
    "O perfil ativa compressão (comp-lzo/compress), que tem riscos conhecidos de segurança. Ela foi mantida porque o servidor pode exigi-la; prefira desativá-la no servidor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil aktiviert Komprimierung (comp-lzo/compress), die bekannte Sicherheitsrisiken hat. Sie wurde beibehalten, weil der Server sie verlangen kann; deaktiviere sie besser auf dem Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile turns on compression (comp-lzo/compress), which has known security risks. It was kept because the server may require it; prefer turning it off on the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil activa la compresión (comp-lzo/compress), que tiene riesgos de seguridad conocidos. Se mantuvo porque el servidor puede exigirla; es preferible desactivarla en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil active la compression (comp-lzo/compress), qui présente des risques de sécurité connus. Elle a été conservée car le serveur peut l’exiger ; mieux vaut la désactiver sur le serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल संपीड़न (comp-lzo/compress) चालू करती है, जिसके ज्ञात सुरक्षा जोखिम हैं। इसे रखा गया क्योंकि सर्वर को इसकी आवश्यकता हो सकती है; बेहतर है कि इसे सर्वर पर बंद करें।"
          }
        }
      }
    },
    "O perfil inclui outro arquivo (config), o que não é suportado.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil bindet eine weitere Datei ein (config), was nicht unterstützt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile includes another file (config), which is not supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil incluye otro archivo (config), lo que no es compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil inclut un autre fichier (config), ce qui n’est pas pris en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल में दूसरी फ़ाइल (config) शामिल है, जो समर्थित नहीं है।"
          }
        }
      }
    },
    "O perfil não está em texto legível.": {
      "localizations": {
