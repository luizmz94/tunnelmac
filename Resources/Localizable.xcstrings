    },
    "O perfil não tem [Interface] com PrivateKey; não parece um perfil WireGuard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil hat keine [Interface] mit PrivateKey; es sieht nicht wie ein WireGuard-Profil aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
