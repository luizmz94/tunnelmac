            "state": "translated",
            "value": "Le profil WireGuard dépasse 64 Ko."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WireGuard प्रोफ़ाइल 64 KB से बड़ी है।"
          }
        }
      }
    },
    "O perfil WireGuard tem entradas demais.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das WireGuard-Profil hat zu viele Einträge."
