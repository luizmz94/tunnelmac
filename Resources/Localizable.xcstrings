    },
    "TLS anterior a 1.2 não é aceito; solicite um perfil atualizado.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS älter als 1.2 wird nicht akzeptiert; fordere ein aktualisiertes Profil an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS older than 1.2 is not accepted; ask for an updated profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se acepta TLS anterior a 1.2; solicita un perfil actualizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS antérieur à 1.2 n’est pas accepté ; demandez un profil à jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1.2 से पुराना TLS स्वीकार नहीं है; अपडेट की गई प्रोफ़ाइल माँगें।"
          }
        }
      }
    },
    "Table = off: nenhuma rota é criada; só o tráfego para as redes que você rotear por conta própria usará o túnel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Table = off: Es wird keine Route angelegt; nur Verkehr zu Netzen, die du selbst routest, nutzt den Tunnel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Table = off: no route is created; only traffic to networks you route yourself will use the tunnel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Table = off: no se crea ninguna ruta; solo el tráfico a las redes que enrutes por tu cuenta usará el túnel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Table = off : aucune route n’est créée ; seul le trafic vers les réseaux que vous routez vous-même utilisera le tunnel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Table = off: कोई रूट नहीं बनता; केवल उन नेटवर्क का ट्रैफ़िक टनल का उपयोग करेगा जिन्हें आप ख़ुद रूट करते हैं।"
          }
        }
      }
    },
    "Tentando reaproveitar a sessão SAML recente. Se o gateway recusar, um único login SAML será iniciado.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, die aktuelle SAML-Sitzung wiederzuverwenden. Lehnt das Gateway ab, startet eine einzelne SAML-Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trying to reuse the recent SAML session. If the gateway rejects it, a single SAML sign-in will start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intentando reutilizar la sesión SAML reciente. Si el gateway la rechaza, se iniciará un único inicio de sesión SAML."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentative de réutilisation de la session SAML récente. Si la passerelle la refuse, une seule authentification SAML sera lancée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल के SAML सत्र का पुनः उपयोग करने का प्रयास। यदि गेटवे अस्वीकार करे, तो एक SAML साइन-इन शुरू होगा।"
          }
        }
