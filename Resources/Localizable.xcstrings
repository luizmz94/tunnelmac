    "TunnelMac quer aprovar o OpenConnect (GlobalProtect) para conectar suas VPNs. O serviço vai usar só uma cópia protegida de %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TunnelMac möchte OpenConnect (GlobalProtect) genehmigen, um deine VPNs zu verbinden. Der Dienst verwendet nur eine geschützte Kopie von %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TunnelMac wants to approve OpenConnect (GlobalProtect) to connect your VPNs. The service will only use a protected copy of %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TunnelMac quiere aprobar OpenConnect (GlobalProtect) para conectar tus VPN. El servicio solo usará una copia protegida de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TunnelMac souhaite approuver OpenConnect (GlobalProtect) pour connecter vos VPN. Le service n’utilisera qu’une copie protégée de %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TunnelMac आपके VPN कनेक्ट करने के लिए OpenConnect (GlobalProtect) को अनुमोदित करना चाहता है। सेवा केवल %@ की सुरक्षित प्रति का उपयोग करेगी।"
          }
        }
      }
    },
