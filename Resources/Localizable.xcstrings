    " Aprove o cliente VPN que você usa.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Genehmige den VPN-Client, den du verwendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Approve the VPN client you use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Aprueba el cliente VPN que usas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Approuvez le client VPN que vous utilisez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " जिस VPN क्लाइंट का आप उपयोग करते हैं, उसे अनुमोदित करें।"
          }
        }
      }
    },
    " As ações de conexão ficam indisponíveis até o problema ser resolvido.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Verbindungsaktionen bleiben nicht verfügbar, bis das Problem behoben ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Connection actions stay unavailable until the problem is solved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Las acciones de conexión no estarán disponibles hasta que se resuelva el problema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les actions de connexion restent indisponibles jusqu’à la résolution du problème."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " समस्या हल होने तक कनेक्शन की कार्रवाइयाँ उपलब्ध नहीं रहेंगी।"
          }
        }
      }
    },
    " Veja o guia de ativação no README.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Siehe die Aktivierungsanleitung im README."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " See the activation guide in the README."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Consulta la guía de activación en el README."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Consultez le guide d’activation dans le README."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " README में सक्रियण गाइड देखें।"
          }
        }
      }
    },
    " ainda está na pasta de origem. Apague o original.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " liegt noch im Ursprungsordner. Lösche das Original."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " is still in its original folder. Delete the original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " sigue en la carpeta de origen. Elimina el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " se trouve toujours dans le dossier d’origine. Supprimez l’original."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " अभी भी मूल फ़ोल्डर में है। मूल फ़ाइल हटाएँ।"
          }
        }
      }
    },
    " ainda estão na pasta de origem. Apague os originais.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " liegen noch im Ursprungsordner. Lösche die Originale."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " are still in their original folder. Delete the originals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " siguen en la carpeta de origen. Elimina los originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " se trouvent toujours dans le dossier d’origine. Supprimez les originaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " अभी भी मूल फ़ोल्डर में हैं। मूल फ़ाइलें हटाएँ।"
          }
        }
      }
    },
    "%@\nGuarde o arquivo em local seguro.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nBewahre die Datei an einem sicheren Ort auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nKeep the file in a safe place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nGuarda el archivo en un lugar seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nConservez le fichier en lieu sûr."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nफ़ाइल को सुरक्षित जगह पर रखें।"
          }
        }
      }
    },
