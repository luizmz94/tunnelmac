        }
      }
    },
    "Este certificado já está no Keychain. Escolha-o na lista \"Certificado do cliente\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Zertifikat ist bereits im Schlüsselbund. Wähle es in der Liste „Client-Zertifikat“."
          }
        },
        "en": {
          "stringUnit": {
