            "value": "%@ को इस Mac के दूसरे उपयोगकर्ता पढ़ सकते हैं"
          }
        }
      }
    },
    "%@ pode validar a identidade do servidor. Solicite um perfil com remote-cert-tls server e verify-x509-name, sem scripts ou plugins; a política não será removida automaticamente.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann die Identität des Servers prüfen. Fordere ein Profil mit remote-cert-tls server und verify-x509-name ohne Skripte oder Plug-ins an; die Richtlinie wird nicht automatisch entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can validate the server’s identity. Ask for a profile with remote-cert-tls server and verify-x509-name, without scripts or plugins; the policy will not be removed automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ puede validar la identidad del servidor. Solicita un perfil con remote-cert-tls server y verify-x509-name, sin scripts ni plugins; la política no se eliminará automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ peut valider l’identité du serveur. Demandez un profil avec remote-cert-tls server et verify-x509-name, sans scripts ni plugins ; la règle ne sera pas supprimée automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सर्वर की पहचान सत्यापित कर सकता है। remote-cert-tls server और verify-x509-name वाली, बिना स्क्रिप्ट या प्लग-इन की प्रोफ़ाइल माँगें; यह नीति अपने-आप नहीं हटाई जाएगी।"
          }
        }
      }
    },
