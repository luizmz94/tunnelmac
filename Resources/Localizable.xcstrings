    "%@ (não encontrado no Keychain)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (nicht im Schlüsselbund gefunden)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (not found in the Keychain)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (no encontrado en el llavero)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (introuvable dans le trousseau)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (कीचेन में नहीं मिला)"
          }
        }
      }
    },
    "%@ (script de DNS executado como root) está em local alterável sem senha de administrador. A aprovação congela estes bytes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (ein als root ausgeführtes DNS-Skript) liegt an einem Ort, der ohne Administratorpasswort geändert werden kann. Die Genehmigung friert diese Bytes ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (a DNS script run as root) is in a location that can be changed without an administrator password. Approval freezes these bytes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (script de DNS ejecutado como root) está en una ubicación modificable sin contraseña de administrador. La aprobación congela estos bytes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (script DNS exécuté en tant que root) se trouve à un emplacement modifiable sans mot de passe administrateur. L’approbation fige ces octets."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (root के रूप में चलने वाली DNS स्क्रिप्ट) ऐसी जगह पर है जिसे व्यवस्थापक पासवर्ड के बिना बदला जा सकता है। अनुमोदन इन बाइट्स को स्थिर कर देता है।"
          }
        }
      }
    },
    "%@ Em Configurações › Serviço privilegiado, use Aprovar %@… (requer administrador).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Verwende unter Einstellungen › Privilegierter Dienst „%@ genehmigen …“ (erfordert einen Administrator)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ In Settings › Privileged service, use Approve %@… (requires an administrator)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ En Ajustes › Servicio con privilegios, usa Aprobar %@… (requiere un administrador)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Dans Réglages › Service privilégié, utilisez Approuver %@… (nécessite un administrateur)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सेटिंग्स › विशेषाधिकार प्राप्त सेवा में, %@ अनुमोदित करें… का उपयोग करें (व्यवस्थापक आवश्यक)।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ Em Configurações › Serviço privilegiado, use Aprovar %2$@… (requer administrador)."
          }
        }
      }
    },
    "%@ Limpeza de rede pendente; reinicie o serviço para tentar recuperar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Netzwerkbereinigung ausstehend; starte den Dienst neu, um die Wiederherstellung zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Network cleanup pending; restart the service to try to recover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Limpieza de red pendiente; reinicia el servicio para intentar recuperarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nettoyage réseau en attente ; redémarrez le service pour tenter la récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ नेटवर्क सफ़ाई लंबित है; पुनर्प्राप्ति के लिए सेवा को फिर से शुरू करें।"
          }
        }
      }
    },
    "%@ ainda não aprovado no serviço": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ im Dienst noch nicht genehmigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ not yet approved in the service"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún no aprobado en el servicio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pas encore approuvé dans le service"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अभी सेवा में अनुमोदित नहीं है"
          }
        }
      }
    },
    "%@ está em local alterável sem senha de administrador (dono uid %u). A aprovação congela exatamente estes bytes numa cópia protegida; confira a origem antes de aprovar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ liegt an einem Ort, der ohne Administratorpasswort geändert werden kann (Eigentümer-UID %2$u). Die Genehmigung friert genau diese Bytes in einer geschützten Kopie ein; prüfe die Herkunft vor der Genehmigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is in a location that can be changed without an administrator password (owner uid %2$u). Approval freezes exactly these bytes in a protected copy; check the source before approving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está en una ubicación modificable sin contraseña de administrador (uid del propietario %2$u). La aprobación congela exactamente estos bytes en una copia protegida; verifica el origen antes de aprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se trouve à un emplacement modifiable sans mot de passe administrateur (uid du propriétaire %2$u). L’approbation fige exactement ces octets dans une copie protégée ; vérifiez la provenance avant d’approuver."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ऐसी जगह पर है जिसे व्यवस्थापक पासवर्ड के बिना बदला जा सकता है (स्वामी uid %2$u)। अनुमोदन ठीक इन्हीं बाइट्स को एक सुरक्षित कॉपी में स्थिर कर देता है; अनुमोदन से पहले स्रोत जाँच लें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ está em local alterável sem senha de administrador (dono uid %2$u). A aprovação congela exatamente estes bytes numa cópia protegida; confira a origem antes de aprovar."
          }
        }
      }
    },
    "%@ falhou (código %lld).": {
      "localizations": {
