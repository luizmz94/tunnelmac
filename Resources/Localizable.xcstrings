          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway GlobalProtect: vpn.ejemplo.com o vpn.ejemplo.com:4443"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle GlobalProtect : vpn.exemple.com ou vpn.exemple.com:4443"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GlobalProtect गेटवे: vpn.example.com या vpn.example.com:4443"
          }
        }
      }
    },
    "O gateway indicou um login SAML fora de HTTPS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat eine SAML-Anmeldung außerhalb von HTTPS angegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway pointed to a SAML login outside HTTPS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway indicó un inicio de sesión SAML fuera de HTTPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle a indiqué une connexion SAML hors HTTPS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेटवे ने HTTPS के बाहर SAML लॉगिन बताया।"
          }
        }
      }
    },
    "O gateway informou que a autenticação SAML não foi concluída.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway meldet, dass die SAML-Authentifizierung nicht abgeschlossen wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway reported that the SAML authentication was not completed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway informó que la autenticación SAML no se completó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle indique que l’authentification SAML n’a pas abouti."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेटवे ने बताया कि SAML प्रमाणीकरण पूरा नहीं हुआ।"
          }
        }
      }
    },
    "O gateway não anunciou login pelo navegador padrão; o retorno pode não chegar ao TunnelMac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat keine Anmeldung über den Standardbrowser angekündigt; die Rückgabe erreicht TunnelMac möglicherweise nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway did not announce login through the default browser; the return may not reach TunnelMac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway no anunció el inicio de sesión por el navegador predeterminado; el retorno podría no llegar a TunnelMac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle n’a pas annoncé de connexion par le navigateur par défaut ; le retour pourrait ne pas atteindre TunnelMac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेटवे ने डिफ़ॉल्ट ब्राउज़र से लॉगिन की घोषणा नहीं की; वापसी TunnelMac तक शायद न पहुँचे।"
          }
        }
      }
    },
    "O gateway não enviou o pedido SAML.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat die SAML-Anfrage nicht gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway did not send the SAML request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway no envió la solicitud SAML."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle n’a pas envoyé la requête SAML."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेटवे ने SAML अनुरोध नहीं भेजा।"
          }
        }
      }
    },
    "O gateway pediu um relatório HIP, que o TunnelMac não envia; alguns recursos da rede podem ficar limitados.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat einen HIP-Bericht angefordert, den TunnelMac nicht sendet; einige Netzwerkressourcen können eingeschränkt sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway asked for a HIP report, which TunnelMac does not send; some network resources may be limited."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway pidió un informe HIP, que TunnelMac no envía; algunos recursos de la red pueden quedar limitados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle a demandé un rapport HIP, que TunnelMac n’envoie pas ; certaines ressources du réseau peuvent être limitées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेटवे ने HIP रिपोर्ट माँगी, जिसे TunnelMac नहीं भेजता; कुछ नेटवर्क संसाधन सीमित हो सकते हैं।"
          }
        }
      }
    },
    "O gateway recusou a sessão SAML salva (expirada ou encerrada). Ela foi descartada; iniciando um login SAML no navegador.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat die gespeicherte SAML-Sitzung abgelehnt (abgelaufen oder beendet). Sie wurde verworfen; SAML-Anmeldung im Browser wird gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway rejected the saved SAML session (expired or ended). It was discarded; starting a SAML sign-in in the browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway rechazó la sesión SAML guardada (caducada o cerrada). Se descartó; iniciando un inicio de sesión SAML en el navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle a refusé la session SAML enregistrée (expirée ou terminée). Elle a été supprimée ; lancement d’une authentification SAML dans le navigateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेटवे ने सहेजा गया SAML सत्र अस्वीकार किया (समाप्त या बंद)। उसे हटा दिया गया; ब्राउज़र में SAML साइन-इन शुरू हो रहा है।"
          }
        }
      }
    },
    "O gateway recusou a sessão do login SAML. Conecte de novo para abrir um novo login no navegador.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat die SAML-Sitzung abgelehnt. Verbinde dich erneut, um eine neue Anmeldung im Browser zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway refused the SAML login session. Connect again to start a new login in the browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway rechazó la sesión del inicio de sesión SAML. Conéctate de nuevo para abrir un nuevo inicio de sesión en el navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle a refusé la session SAML. Reconnectez-vous pour lancer une nouvelle connexion dans le navigateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेटवे ने SAML लॉगिन सत्र अस्वीकार कर दिया। ब्राउज़र में नया लॉगिन शुरू करने के लिए फिर से कनेक्ट करें।"
          }
        }
      }
    },
    "O gateway respondeu ao prelogin com HTTP %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat den Prelogin mit HTTP %lld beantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway answered the prelogin with HTTP %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway respondió al prelogin con HTTP %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La passerelle a répondu au prelogin avec HTTP %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गेटवे ने प्रीलॉगिन का उत्तर HTTP %lld से दिया।"
          }
        }
      }
    },
    "O login abre no navegador padrão. Ao terminar, permita que o navegador abra o TunnelMac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung öffnet sich im Standardbrowser. Erlaube danach dem Browser, TunnelMac zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login opens in the default browser. When you finish, let the browser open TunnelMac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión se abre en el navegador predeterminado. Al terminar, permite que el navegador abra TunnelMac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion s’ouvre dans le navigateur par défaut. Ensuite, autorisez le navigateur à ouvrir TunnelMac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन डिफ़ॉल्ट ब्राउज़र में खुलता है। पूरा होने पर ब्राउज़र को TunnelMac खोलने दें।"
          }
        }
      }
    },
    "O login no navegador não retornou em 5 minutos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung im Browser kam nicht innerhalb von 5 Minuten zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The browser login did not return within 5 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión en el navegador no volvió en 5 minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion dans le navigateur n’est pas revenue en 5 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउज़र लॉगिन 5 मिनट में वापस नहीं आया।"
          }
        }
      }
    },
    "O macOS aguarda sua aprovação em Ajustes do Sistema › Itens de Início.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS wartet auf deine Genehmigung in Systemeinstellungen › Anmeldeobjekte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is waiting for your approval in System Settings › Login Items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS espera tu aprobación en Ajustes del Sistema › Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS attend votre approbation dans Réglages Système › Ouverture."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS सिस्टम सेटिंग्स › लॉगिन आइटम में आपके अनुमोदन की प्रतीक्षा कर रहा है।"
          }
        }
      }
    },
    "O macOS pede a senha de administrador uma vez para cada cliente.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt einmal pro Client nach dem Administratorpasswort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for the administrator password once for each client."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pide la contraseña de administrador una vez por cada cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande le mot de passe administrateur une fois pour chaque client."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS हर क्लाइंट के लिए एक बार व्यवस्थापक पासवर्ड माँगता है।"
          }
        }
      }
    },
    "O macOS pede uma aprovação agora e pronto.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt jetzt einmal nach einer Genehmigung – fertig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for one approval now, and that’s it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pide una aprobación ahora y listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande une approbation maintenant, et c’est tout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS अभी एक बार अनुमोदन माँगता है, बस।"
          }
        }
      }
    },
    "O macOS recusou a assinatura do app. Daemons exigem app assinado com Team ID e notarizado; veja o guia de ativação.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat die Signatur der App abgelehnt. Daemons erfordern eine mit Team-ID signierte und notarisierte App; siehe Aktivierungsanleitung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS rejected the app’s signature. Daemons require an app signed with a Team ID and notarized; see the activation guide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS rechazó la firma de la app. Los daemons requieren una app firmada con Team ID y notarizada; consulta la guía de activación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a refusé la signature de l’app. Les daemons exigent une app signée avec un Team ID et notarisée ; consultez le guide d’activation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ने ऐप का हस्ताक्षर अस्वीकार किया। Daemons के लिए Team ID से हस्ताक्षरित और नोटराइज़्ड ऐप आवश्यक है; सक्रियण गाइड देखें।"
          }
        }
      }
    },
    "O material de <%@> aparece mais de uma vez no perfil.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Material von <%@> kommt im Profil mehrfach vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The <%@> material appears more than once in the profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El material de <%@> aparece más de una vez en el perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu de <%@> apparaît plusieurs fois dans le profil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "<%@> की सामग्री प्रोफ़ाइल में एक से अधिक बार है।"
          }
        }
      }
    },
    "O novo idioma aparece quando o TunnelMac abrir de novo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Sprache erscheint, wenn TunnelMac erneut geöffnet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new language appears when TunnelMac opens again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo idioma aparecerá cuando TunnelMac se abra de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue apparaîtra à la prochaine ouverture de TunnelMac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TunnelMac फिर से खुलने पर नई भाषा दिखेगी।"
          }
        }
      }
    },
    "O novo perfil substitui o atual ao salvar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das neue Profil ersetzt beim Sichern das aktuelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new profile replaces the current one when you save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo perfil reemplaza al actual al guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau profil remplace l’actuel à l’enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने पर नई प्रोफ़ाइल मौजूदा प्रोफ़ाइल की जगह ले लेगी।"
          }
        }
      }
    },
    "O openfortivpn aprovado não lê a sessão SAML pela entrada padrão.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das genehmigte openfortivpn liest die SAML-Sitzung nicht über die Standardeingabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approved openfortivpn does not read the SAML session from standard input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El openfortivpn aprobado no lee la sesión SAML por la entrada estándar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’openfortivpn approuvé ne lit pas la session SAML sur l’entrée standard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमोदित openfortivpn मानक इनपुट से SAML सत्र नहीं पढ़ता।"
          }
        }
      }
    },
    "O openfortivpn instalado não informou a sessão SAML; a próxima conexão usará o navegador.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das installierte openfortivpn hat die SAML-Sitzung nicht gemeldet; die nächste Verbindung nutzt den Browser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed openfortivpn did not report the SAML session; the next connection will use the browser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El openfortivpn instalado no informó la sesión SAML; la próxima conexión usará el navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’openfortivpn installé n’a pas signalé la session SAML ; la prochaine connexion utilisera le navigateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉल किए गए openfortivpn ने SAML सत्र नहीं बताया; अगला कनेक्शन ब्राउज़र का उपयोग करेगा।"
          }
        }
      }
    },
    "O perfil %@ desta conexão não foi encontrado. Importe-o novamente.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das %@-Profil dieser Verbindung wurde nicht gefunden. Importiere es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection’s %@ profile was not found. Import it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el perfil %@ de esta conexión. Vuelve a importarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil %@ de cette connexion est introuvable. Importez-le de nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कनेक्शन की %@ प्रोफ़ाइल नहीं मिली। इसे फिर से आयात करें।"
          }
        }
      }
    },
    "O perfil WireGuard contém %@, que o serviço não aceita.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das WireGuard-Profil enthält %@, was der Dienst nicht akzeptiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WireGuard profile contains %@, which the service does not accept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil WireGuard contiene %@, que el servicio no acepta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil WireGuard contient %@, que le service n’accepte pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WireGuard प्रोफ़ाइल में %@ है, जिसे सेवा स्वीकार नहीं करती।"
          }
        }
      }
    },
    "O perfil WireGuard contém bytes nulos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das WireGuard-Profil enthält Nullbytes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WireGuard profile contains null bytes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil WireGuard contiene bytes nulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil WireGuard contient des octets nuls."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WireGuard प्रोफ़ाइल में शून्य बाइट्स हैं।"
          }
        }
      }
    },
    "O perfil WireGuard passa de 64 KB.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das WireGuard-Profil ist größer als 64 KB."
          }
        },
        "en": {
