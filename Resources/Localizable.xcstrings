    "Solicitando encerramento normal e aguardando a limpeza de rotas e DNS…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normales Beenden angefordert, warte auf die Bereinigung von Routen und DNS …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requesting a normal shutdown and waiting for routes and DNS to be cleaned up…"
          }
        },
