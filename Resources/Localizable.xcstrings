        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप ने प्रोफ़ाइल पहले ही सहेज ली है। मूल फ़ाइल की अब आवश्यकता नहीं है और उसमें अभी भी निजी कुंजी है:\n\n"
          }
