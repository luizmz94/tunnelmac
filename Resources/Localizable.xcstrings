        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन शुरू हो रहा है। रूट और DNS %@ संभाले जाएँगे; ओवरलैप होने वाले नेटवर्क टकराव पैदा कर सकते हैं।"
