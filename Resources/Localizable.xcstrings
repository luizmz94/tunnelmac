    "Cliente exigiu encerramento forçado após 10 s. Confira a conectividade e o estado da rede antes de reconectar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Client musste nach 10 s zwangsweise beendet werden. Prüfe die Verbindung und den Netzwerkstatus, bevor du neu verbindest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The client required a forced shutdown after 10 s. Check connectivity and the network state before reconnecting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cliente requirió un cierre forzado tras 10 s. Revisa la conectividad y el estado de la red antes de reconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le client a nécessité un arrêt forcé après 10 s. Vérifiez la connectivité et l’état du réseau avant de vous reconnecter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "10 s बाद क्लाइंट को ज़बरदस्ती बंद करना पड़ा। फिर से कनेक्ट करने से पहले कनेक्टिविटी और नेटवर्क स्थिति जाँचें।"
          }
        }
      }
    },
