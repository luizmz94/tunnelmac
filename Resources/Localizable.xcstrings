    },
    "Evite palavras e senhas comuns, como “senha”, “123456” ou anos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide gängige Wörter und Passwörter wie „passwort“, „123456“ oder Jahreszahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid common words and passwords, such as “password”, “123456” or years."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita palabras y contraseñas comunes, como «contraseña», «123456» o años."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez les mots et mots de passe courants, comme « motdepasse », « 123456 » ou des années."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आम शब्दों और पासवर्ड से बचें, जैसे “password”, “123456” या वर्ष।"
          }
        }
      }
    },
    "Evite repetições e sequências, como “aaa”, “abc” ou “qwe”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide Wiederholungen und Folgen wie „aaa“, „abc“ oder „qwe“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid repetitions and sequences, such as “aaa”, “abc” or “qwe”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita repeticiones y secuencias, como «aaa», «abc» o «qwe»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez les répétitions et suites, comme « aaa », « abc » ou « qwe »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोहराव और क्रम से बचें, जैसे “aaa”, “abc” या “qwe”।"
          }
        }
      }
    },
