    "Autoridade intermediária, emitida por %@. Ela não recebe confiança própria: herda a da raiz.\n\n%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischenzertifizierungsstelle, ausgestellt von %@. Sie erhält kein eigenes Vertrauen, sondern erbt das der Root.\n\n%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intermediate authority, issued by %@. It gets no trust of its own: it inherits the root’s.\n\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoridad intermedia, emitida por %@. No recibe confianza propia: hereda la de la raíz.\n\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorité intermédiaire, émise par %@. Elle ne reçoit pas de confiance propre : elle hérite de celle de la racine.\n\n%@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मध्यवर्ती प्राधिकरण, %@ द्वारा जारी। इसे अपना अलग भरोसा नहीं मिलता: यह रूट का भरोसा अपनाता है।\n\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "Autoridade intermediária, emitida por %1$@. Ela não recebe confiança própria: herda a da raiz.\n\n%2$@"
          }
        }
      }
    },
