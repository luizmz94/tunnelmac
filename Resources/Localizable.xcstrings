    "A assinatura deste processo não é emitida pela Apple para o Team %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Signatur dieses Prozesses wurde nicht von Apple für das Team %@ ausgestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This process’s signature is not issued by Apple for Team %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma de este proceso no fue emitida por Apple para el Team %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La signature de ce processus n’est pas émise par Apple pour l’équipe %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोसेस का हस्ताक्षर Apple द्वारा Team %@ के लिए जारी नहीं किया गया है।"
          }
        }
      }
    },
    "A atualização não corresponde à versão oferecida. Tente verificar novamente.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update entspricht nicht der angebotenen Version. Versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update does not match the version offered. Try checking again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización no corresponde a la versión ofrecida. Vuelve a buscar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour ne correspond pas à la version proposée. Réessayez la vérification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट प्रस्तावित संस्करण से मेल नहीं खाता। फिर से जाँचें।"
          }
        }
      }
    },
    "A conexão e o perfil serão removidos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung und das Profil werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection and the profile will be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán la conexión y el perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion et le profil seront supprimés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन और प्रोफ़ाइल हटा दिए जाएँगे।"
          }
        }
      }
    },
    "A conexão é feita pelo %@, um projeto open source independente; este app só gerencia. Abrir o projeto oficial: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung stellt %@ her, ein unabhängiges Open-Source-Projekt; diese App verwaltet sie nur. Offizielles Projekt öffnen: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection is made by %@, an independent open source project; this app only manages it. Open the official project: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión la realiza %@, un proyecto de código abierto independiente; esta app solo la gestiona. Abrir el proyecto oficial: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion est assurée par %@, un projet open source indépendant ; cette app ne fait que la gérer. Ouvrir le projet officiel : %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन %@ द्वारा बनाया जाता है, जो एक स्वतंत्र ओपन सोर्स प्रोजेक्ट है; यह ऐप केवल उसका प्रबंधन करता है। आधिकारिक प्रोजेक्ट खोलें: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "new",
            "value": "A conexão é feita pelo %1$@, um projeto open source independente; este app só gerencia. Abrir o projeto oficial: %2$@"
          }
        }
      }
    },
    "A conexão, a senha e o perfil serão removidos.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung, das Passwort und das Profil werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection, the password and the profile will be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán la conexión, la contraseña y el perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion, le mot de passe et le profil seront supprimés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन, पासवर्ड और प्रोफ़ाइल हटा दिए जाएँगे।"
          }
        }
      }
    },
    "A correção sugerida não se aplica mais a este perfil.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorgeschlagene Korrektur gilt nicht mehr für dieses Profil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The suggested fix no longer applies to this profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La corrección sugerida ya no se aplica a este perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La correction suggérée ne s’applique plus à ce profil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाया गया सुधार अब इस प्रोफ़ाइल पर लागू नहीं होता।"
          }
        }
      }
    },
    "A correção sugerida não se aplica mais ao perfil.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorgeschlagene Korrektur gilt nicht mehr für das Profil."
          }
        },
