    "Já existe %@ com o mesmo identificador. Remova esse item manualmente antes de ativar; o app não altera arquivos que não registrou.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existiert bereits mit derselben Kennung. Entferne dieses Objekt manuell vor dem Aktivieren; die App ändert keine Dateien, die sie nicht registriert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ already exists with the same identifier. Remove that item manually before turning it on; the app does not change files it did not register."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe %@ con el mismo identificador. Elimina ese elemento manualmente antes de activar; la app no modifica archivos que no registró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe déjà avec le même identifiant. Supprimez cet élément manuellement avant l’activation ; l’app ne modifie pas les fichiers qu’elle n’a pas enregistrés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ उसी पहचानकर्ता के साथ पहले से मौजूद है। चालू करने से पहले उस आइटम को मैन्युअल रूप से हटाएँ; ऐप उन फ़ाइलों को नहीं बदलता जिन्हें उसने पंजीकृत नहीं किया।"
          }
        }
      }
    },
