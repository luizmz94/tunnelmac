    "Usado enquanto uma VPN está conectada.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, solange ein VPN verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used while a VPN is connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa mientras una VPN está conectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pendant qu’un VPN est connecté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN कनेक्ट रहने के दौरान उपयोग होता है।"
          }
        }
      }
    },
    "Usado só quando o certificado do gateway não é validado pelo macOS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur verwendet, wenn macOS das Zertifikat des Gateways nicht bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only when macOS does not validate the gateway’s certificate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa cuando macOS no valida el certificado del gateway."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé seulement quand macOS ne valide pas le certificat de la passerelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल तब उपयोग होता है जब macOS गेटवे का प्रमाणपत्र मान्य नहीं करता।"
          }
        }
      }
    },
    "Usando o certificado do cliente \"%@\" do Keychain. Se o macOS pedir, permita o acesso do TunnelMac à chave.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Client-Zertifikat „%@“ aus dem Schlüsselbund wird verwendet. Falls macOS fragt, erlaube TunnelMac den Zugriff auf den Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the client certificate \"%@\" from the Keychain. If macOS asks, allow TunnelMac to access the key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usando el certificado de cliente \"%@\" del llavero. Si macOS lo pide, permite que TunnelMac acceda a la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation du certificat client « %@ » du trousseau. Si macOS le demande, autorisez TunnelMac à accéder à la clé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीचेन से क्लाइंट प्रमाणपत्र \"%@\" का उपयोग हो रहा है। यदि macOS पूछे, तो TunnelMac को कुंजी तक पहुँच की अनुमति दें।"
          }
        }
      }
    },
    "Usar auth %@ em vez de %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "auth %@ statt %@ verwenden"
          }
