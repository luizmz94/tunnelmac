          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This digest will replace the trusted certificate already registered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este digest reemplazará el certificado de confianza ya registrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce condensé remplacera le certificat de confiance déjà enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डाइजेस्ट पहले से दर्ज भरोसेमंद प्रमाणपत्र को बदल देगा।"
          }
