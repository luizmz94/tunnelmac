            "state": "translated",
            "value": "%@: तर्कों की अप्रत्याशित संख्या।"
          }
        }
      }
    },
    "%@: quebra de linha, caractere nulo ou início com < não são suportados.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Zeilenumbrüche, Nullzeichen oder ein führendes < werden nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: line breaks, null characters or a leading < are not supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: no se admiten saltos de línea, caracteres nulos ni un < al inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : les sauts de ligne, caractères nuls ou un < initial ne sont pas pris en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: लाइन ब्रेक, शून्य वर्ण या शुरुआत में < समर्थित नहीं हैं।"
          }
        }
      }
    },
    "%@: referência a arquivo não é aceita; o material precisa estar no próprio perfil.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Dateiverweise werden nicht akzeptiert; das Material muss im Profil selbst stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: file references are not accepted; the material must be inside the profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: no se aceptan referencias a archivos; el material debe estar en el propio perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : les références à des fichiers ne sont pas acceptées ; le contenu doit figurer dans le profil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: फ़ाइल संदर्भ स्वीकार नहीं हैं; सामग्री प्रोफ़ाइल के अंदर ही होनी चाहिए।"
          }
