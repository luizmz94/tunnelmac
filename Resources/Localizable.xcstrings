    "Encerramento e limpeza não confirmados em 30 s. O app permanece aberto; verifique o serviço antes de sair novamente.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden und Bereinigung wurden nicht innerhalb von 30 s bestätigt. Die App bleibt geöffnet; prüfe den Dienst, bevor du erneut beendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shutdown and cleanup were not confirmed within 30 s. The app stays open; check the service before quitting again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se confirmaron el cierre y la limpieza en 30 s. La app sigue abierta; revisa el servicio antes de volver a salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrêt et le nettoyage n’ont pas été confirmés en 30 s. L’app reste ouverte ; vérifiez le service avant de quitter de nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "30 s में बंद होने और सफ़ाई की पुष्टि नहीं हुई। ऐप खुला रहेगा; फिर से बंद करने से पहले सेवा जाँचें।"
          }
        }
      }
    },
