            "state": "translated",
            "value": "El perfil no tiene la autoridad certificadora (<ca>)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil n’a pas d’autorité de certification (<ca>)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल में प्रमाणपत्र प्राधिकरण (<ca>) नहीं है।"
          }
        }
      }
    },
    "O perfil não tem nenhum [Peer].": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil hat keinen [Peer]."
          }
        },
        "en": {
